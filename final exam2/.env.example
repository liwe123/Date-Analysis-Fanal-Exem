# ── RAG 智能助手环境变量配置示例 ──

# [必填] OpenAI API 密钥
OPENAI_API_KEY=your-api-key-here

# [可选] 自定义 API 接口基地址（若使用第三方转发或兼容 API 必填，默认为官方地址）
# OPENAI_BASE_URL=https://api.openai.com/v1

# [可选] 对话模型名称（默认：gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini

# [可选] 嵌入模型名称（local=本地模型 / remote=远程GPU服务 / 其他=OpenAI兼容API）
# OPENAI_EMBEDDING_MODEL=local

# [可选] 远程嵌入服务地址（仅在 OPENAI_EMBEDDING_MODEL=remote 时使用）
# 部署方式参考 scripts/embedding_server.py 和 scripts/setup_autodl.sh
# OPENAI_EMBEDDING_BASE_URL=http://your-autodl-ip:6008/v1

# [可选] 远程嵌入服务访问令牌（AutoDL 公网服务建议必须配置）
# 本地和远程服务端保持一致；配置后请求必须携带 Bearer Token
# EMBEDDING_SERVER_TOKEN=change-this-token

# [可选] 本地/远程嵌入模型名称（默认：BAAI/bge-large-zh-v1.5）
# LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# [可选] HuggingFace 镜像端点（国内网络环境用于加速模型下载，默认：https://hf-mirror.com）
# HF_ENDPOINT=https://hf-mirror.com
