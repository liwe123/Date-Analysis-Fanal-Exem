# ── RAG 智能助手环境变量配置示例 ──

# [必填] OpenAI API 密钥
OPENAI_API_KEY=your-api-key-here

# [可选] 自定义 API 接口基地址（若使用第三方转发或兼容 API 必填，默认为官方地址）
# OPENAI_BASE_URL=https://api.openai.com/v1

# [可选] 对话模型名称（默认：gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini

# [可选] 嵌入模型名称（设置为 local 或保持为空表示使用本地模型）
# OPENAI_EMBEDDING_MODEL=local

# [可选] 本地嵌入模型名称（默认：Qwen/Qwen3-Embedding-0.6B）
# LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# [可选] HuggingFace 镜像端点（国内网络环境用于加速模型下载，默认：https://hf-mirror.com）
# HF_ENDPOINT=https://hf-mirror.com

